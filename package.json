{
  "name": "sawdust-cinema",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "update-version": "node src/assets/javascript/version.js",
    "serve": "vite",
    "build": "yarn update-version && vite build",
    "lint": "eslint --ext .js,.jsx,.vue --fix --no-error-on-unmatched-pattern src tests *.js",
    "deploy": "yarn build && aws s3 sync dist/ s3://sawdust-cinema --profile personal-deploy && aws cloudfront create-invalidation --distribution-id E1S2ZXGVHWW8OH --paths '/*' --profile personal-deploy > invalidation_output.txt",
    "backup": "node scripts/backup-db.mjs",
    "restore": "node scripts/restore-db.mjs",
    "predeploy": "node scripts/backup-db.mjs --quiet || echo backup-skipped",
    "preview": "vite preview"
  },
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "axios": "^1.13.5",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "core-js": "^3.8.3",
    "firebase": "9",
    "lodash": "^4.17.23",
    "vue": "^3.2.13",
    "vue-router": "^4.0.3",
    "vuex": "^4.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.12.16",
    "@babel/eslint-parser": "^7.12.16",
    "@vitejs/plugin-vue": "5.2.4",
    "@vue/eslint-config-standard": "^6.1.0",
    "autoprefixer": "^10.4.20",
    "dotenv": "^16.4.5",
    "eslint": "^7.32.0",
    "eslint-plugin-import": "^2.25.3",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^5.1.0",
    "eslint-plugin-vue": "^8.0.3",
    "nodemon": "^3.1.14",
    "sass": "^1.32.7",
    "vite": "5.4.21"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/vue3-essential",
      "@vue/standard"
    ],
    "parserOptions": {
      "parser": "@babel/eslint-parser",
      "requireConfigFile": false
    },
    "rules": {
      "vue/multi-word-component-names": "off",
      "vue/no-unused-components": "off",
      "no-trailing-spaces": "warn",
      "eol-last": "off",
      "quotes": [
        "off",
        "double"
      ],
      "semi": "off",
      "comma-dangle": "off",
      "space-before-function-paren": "warn",
      "indent": "warn",
      "no-undef": "warn",
      "no-unused-vars": "warn",
      "no-empty": "warn",
      "prefer-const": "warn",
      "no-debugger": "warn"
    }
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ]
}
