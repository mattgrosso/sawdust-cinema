{
  "rules": {
    // Sawdust Cinema. Locked down 2026-08-28 after a Firebase alert found
    // this database wide open at the root — every guest's name and email
    // readable by anyone who opened the JS bundle and found the URL.
    //
    // The shape of the fix, because it is not obvious from the rules alone:
    // an RSVP is stored as TWO records under one id. `reservations/<id>`
    // holds only the seat counts, and stays public because the home page
    // counts spots-left from it. `guests/<id>` holds the name and email, and
    // only the admin can read it. Splitting them is what let the private half
    // become private without taking the public schedule offline.
    ".read": false,
    ".write": false,

    // The schedule: public to read (it is the point of the site), and only
    // the admin may change it. Before this, any visitor could delete every
    // screening.
    "showings": {
      ".read": true,
      ".write": "auth != null && auth.token.email === 'mattgrosso@gmail.com'"
    },

    // The public half of an RSVP: which showings, how many seats, when.
    // Anyone may CREATE one (that is the RSVP form, and it is deliberately
    // open — guests do not sign in). Only the admin may change or delete an
    // existing one.
    "reservations": {
      ".read": true,
      "$id": {
        ".write": "(!data.exists() && newData.exists()) || (auth != null && auth.token.email === 'mattgrosso@gmail.com')",
        ".validate": "newData.hasChildren(['showings', 'submittedAt']) && newData.child('submittedAt').isString() && newData.child('submittedAt').val().length <= 40",
        "showings": {
          "$showingId": {
            ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 50"
          }
        }
      }
    },

    // The private half: who they are. Create is open for the same reason as
    // above — the RSVP form writes both halves in one atomic update — but
    // NOBODY may read this except the admin, which is the whole point of the
    // change.
    "guests": {
      ".read": "auth != null && auth.token.email === 'mattgrosso@gmail.com'",
      "$id": {
        ".write": "(!data.exists() && newData.exists()) || (auth != null && auth.token.email === 'mattgrosso@gmail.com')",
        ".validate": "newData.hasChildren(['name', 'email']) && newData.child('name').isString() && newData.child('name').val().length > 0 && newData.child('name').val().length <= 200 && newData.child('email').isString() && newData.child('email').val().length <= 320"
      }
    }
  }
}
